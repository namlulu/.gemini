# Ignore everything by default
*

# Unignore shareable root documentation and git config
!.gitignore
!README.md
!GEMINI.md

# Unignore custom agent configurations and prompts
!/config/
!/config/agents/
!/config/agents/**
!/config/prompts/
!/config/prompts/**
!/config/skills/
!/config/skills/**
!/config/plugins/
!/config/plugins/**
!/config/sidecars/
!/config/sidecars/**
!/config/hooks.json

# Explicitly ignore machine-specific configs and state in config/
/config/mcp_config.json
/config/projects/
/config/.migrated

# OS-specific files
.DS_Store
.AppleDouble
.LSOverride
Icon

