# Ignore everything by default
*

# Unignore shareable root documentation and git config
!.gitignore
!README.md

# Unignore custom agent configurations and prompts
!/config/
!/config/agents/
!/config/agents/**
!/config/prompts/
!/config/prompts/**

# Explicitly ignore machine-specific configs and state in config/
/config/mcp_config.json
/config/projects/
/config/.migrated

# OS-specific files
.DS_Store
.AppleDouble
.LSOverride
Icon

